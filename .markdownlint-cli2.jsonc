{
  // `openspec init` writes these skill and command files, and `openspec update`
  // overwrites hand edits. Release Please writes CHANGELOG.md. OpenSpec delta
  // specs, in progress or archived, start with `## ADDED Requirements` by
  // format (MD041). None of them is project prose. Rules stay in .markdownlint.json.
  "ignores": [
    ".claude/skills/**",
    ".claude/commands/opsx/**",
    ".gemini/**",
    ".opencode/**",
    "CHANGELOG.md",
    "openspec/changes/**/specs/**",
    "node_modules/**"
  ]
}
